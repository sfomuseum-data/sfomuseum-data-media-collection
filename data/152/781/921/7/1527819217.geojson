    "millsfield:images_texts": [
      "10L\nPOSTA AERIANA\nLOS ANGELES\n•ZBOR SPECIAL CRAOYA\n- • 3\nBRADOY\nNA\nXia-d\nALEX PAR\nAEROMFILA\n86\nCRAIOVA 31-10•86\nGILMORE\nXR-Pr\n986\nPOSTA ROMANA\nANDREI MIHAI\nYR-PAX\nAndas",
