    "millsfield:images_texts": [
      "AIR\nCALIFORNIA\nFLIGHT SCHEDULE\nEFFECTIVE JAN. 21, 1970\na fare to\nremember\n$20\nPALM SPRINGS\nSAN FRANCISCO\nOAKLAND\nSAN JOSE\nONTARIO\nORANGE COUNTY/ DISNEYLAND",
