    "millsfield:images_texts": [
      "GISLANDE LO\nEUROPE\nOCCIDENTALE\nFiN\nHEISINKT\nLosio\nCKHOLAN\nNO\nROANEMARKU\nNEI\nLAND\nDUBL\nCORANDE BERLAGNE\nLONDRES\nBERLIN\nQAMSTERDAM\n\\PAYS•BASD\nALLEMAGNE\nRIBELGiQUE\n• BRUXELLES\nPARIS LUREMPOUAS\nVIENNEO\n*FRANCETT\nMONACO\nREORTUGAL\nLISBONNE\nTESPA\nRAMADRID\nROMEC\nACQUES LOZU",
